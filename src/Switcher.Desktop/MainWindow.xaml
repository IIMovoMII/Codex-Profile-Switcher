<Window x:Class="Switcher.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Switcher.Desktop.Controls" xmlns:views="clr-namespace:Switcher.Desktop.Views"
        Title="Codex 切换助手" Width="1240" Height="860" MinWidth="1060" MinHeight="730" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{StaticResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{StaticResource WindowFill}" Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
    <Border BorderBrush="#F9FFFFFF" BorderThickness="1" CornerRadius="12"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#85E4EFF3" BorderBrush="#C9FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragTitle">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0"><Border Width="29" Height="29" CornerRadius="7" Background="{StaticResource PrimaryFill}"><ui:SymbolIcon Kind="code" Foreground="White" Width="21" Height="21"/></Border><TextBlock Text="Codex 切换助手" FontWeight="SemiBold" FontSize="16" Margin="12,0,0,0"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,14,0"/>
                <Button Grid.Column="2" Content="检查更新" Style="{StaticResource LinkButton}" Command="{Binding ShowUpdatesCommand}" Margin="0,0,20,0" ToolTip="打开设置与更新"/>
                <Button Grid.Column="3" Content="─" Click="MinimizeWindow" Background="Transparent" BorderBrush="Transparent" Width="44" Padding="0" MinHeight="0" AutomationProperties.Name="最小化"/>
                <Button Grid.Column="4" Content="□" Click="MaximizeWindow" Background="Transparent" BorderBrush="Transparent" Width="44" Padding="0" MinHeight="0" AutomationProperties.Name="最大化或还原"/>
                <Button Grid.Column="5" Click="CloseWindow" Background="Transparent" BorderBrush="Transparent" Width="49" Padding="0" MinHeight="0" AutomationProperties.Name="关闭窗口"><ui:SymbolIcon Kind="close" Width="17" Height="17" Foreground="{StaticResource Ink}"/></Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border IsEnabled="{Binding HasEditor, Converter={StaticResource InverseBoolean}}" Background="{StaticResource SidebarFill}" BorderBrush="#9EFFFFFF" BorderThickness="0,0,1,0" Padding="13,27,13,22"><DockPanel>
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding CurrentPage, Converter={StaticResource ChoiceEquals}, ConverterParameter=settings}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Kind="settings" Width="24" Height="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="设置与更新" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding CurrentPage, Converter={StaticResource ChoiceEquals}, ConverterParameter=accounts}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Kind="user" Width="24" Height="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="账号管理" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding CurrentPage, Converter={StaticResource ChoiceEquals}, ConverterParameter=diagnostics}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Kind="wrench" Width="24" Height="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="诊断与维护" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding CurrentPage, Converter={StaticResource ChoiceEquals}, ConverterParameter=records}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Kind="log" Width="24" Height="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="操作记录" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
                </StackPanel>
            </DockPanel></Border>
            <Grid Grid.Column="1" Margin="28,28,28,22" IsEnabled="{Binding HasEditor, Converter={StaticResource InverseBoolean}}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><views:AccountsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=accounts}"/><views:DiagnosticsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=diagnostics}"/><views:RecordsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=records}"/><views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=settings}"/></Grid>
                <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="17,12" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Kind="{Binding ResultIcon}" Width="22" Height="22" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap" FontSize="12" MaxHeight="52"/><ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent}" Height="4" Foreground="{StaticResource Accent}" Background="#D9E7E2" Margin="0,9,10,2" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0"><Button Content="取消操作" Command="{Binding CancelOperationCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsCancelling, Converter={StaticResource InverseBoolean}}" Margin="0,0,9,0"/><Button Content="查看详情 ›" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="records"/></StackPanel>
                </Grid></Border>
            </Grid>
            <Grid Grid.ColumnSpan="2" Visibility="{Binding HasEditor, Converter={StaticResource BoolVisibility}}" Panel.ZIndex="10">
                <Border Background="#620E2530" MouseLeftButtonDown="DismissEditor"/>
                <views:ProfileEditorView DataContext="{Binding Editor}" Width="610" HorizontalAlignment="Right"/>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="390" Margin="25" Background="#F4FFFFFF" CornerRadius="12" Padding="18" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap" Margin="0,0,0,10"/><ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent}" Height="5" Foreground="{StaticResource Accent}"/><Button Content="取消操作" Command="{Binding CancelOperationCommand}" Margin="0,12,0,0" IsEnabled="{Binding IsCancelling, Converter={StaticResource InverseBoolean}}"/></StackPanel></Border>
            </Grid>
        </Grid>
    </Grid></Border>
</Window>
