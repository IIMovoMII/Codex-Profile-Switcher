<Window x:Class="Switcher.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Profile Switcher" Height="760" Width="1120" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#202B36" />
        <SolidColorBrush x:Key="Muted" Color="#667482" />
        <SolidColorBrush x:Key="Line" Color="#D9E0E6" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D3DC" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F5" />
            <Setter Property="Foreground" Value="#53616E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#D9E0E6" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Codex Profile Switcher" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="账号、配置与模型目录" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E8F3EF" BorderBrush="#C8DED5" BorderThickness="1" Padding="10,6" Margin="0,0,10,0" CornerRadius="3">
                    <TextBlock Text="{Binding CurrentMode}" Foreground="#24644D" FontWeight="SemiBold" />
                </Border>
                <Button Content="导入当前账号" Command="{Binding ImportCurrentCommand}" />
                <Button Content="添加 API" Command="{Binding AddApiCommand}" Margin="0" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}">
            <TabItem Header="账号">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="已保存档案" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="添加官方账号" Command="{Binding ImportOfficialCommand}" />
                            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Line}" RowHeight="38"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" Width="95" />
                            <DataGridTextColumn Header="模型目录方式" Binding="{Binding CatalogMode}" Width="130" />
                            <DataGridTextColumn Header="目录路径" Binding="{Binding CatalogPath}" Width="*" />
                            <DataGridTextColumn Header="更新时间" Binding="{Binding CatalogUpdated}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProfile.Summary}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedProfile.CatalogMessage}" Foreground="#53616E" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="切换到所选账号" Command="{Binding SwitchSelectedCommand}" Background="#176B57" Foreground="White" BorderBrush="#176B57" />
                            <Button Content="设置" Command="{Binding EditSelectedCommand}" />
                            <Button Content="重新授权" Command="{Binding ReauthorizeSelectedCommand}" />
                            <Button Content="重命名" Command="{Binding RenameSelectedCommand}" />
                            <Button Content="删除" Command="{Binding DeleteSelectedCommand}" Margin="0" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="模型目录">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProfile.CatalogMode}" Foreground="{StaticResource Muted}" Margin="0,4,0,14" />
                        <TextBlock Text="模型目录文件" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedCatalogPath, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,8" Padding="8" />
                        <TextBlock Text="目录来源" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding SelectedCatalogSource}" TextWrapping="Wrap" />
                        <TextBlock Text="更新时间" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding SelectedCatalogUpdated}" />
                        <TextBlock Text="{Binding SelectedCatalogMessage}" Foreground="{StaticResource Muted}" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Content="打开模型目录文件" Command="{Binding OpenCatalogCommand}" />
                            <Button Content="打开所在文件夹" Command="{Binding OpenCatalogFolderCommand}" />
                            <Button Content="编辑目录设置" Command="{Binding EditSelectedCommand}" Margin="0" />
                        </WrapPanel>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,14" />
                        <TextBlock Text="目录维护说明" FontWeight="SemiBold" />
                        <TextBlock Text="为兼容官方账号与 API 账号共享聊天，本助手的 API 模式可使用独立的本地模型目录。该目录不会自动从中转站的普通 /v1/models 接口更新。你可以从官方账号缓存同步，或手动维护下方文件；没有官方账号也可以继续使用和编辑已保存的目录。请按完整 Codex 模型目录格式修改，不能只填写模型名称。修改后完全退出并重新启动 Codex 生效。目录中出现某个模型，不代表中转站已经支持调用该模型。"
                                   TextWrapping="Wrap" MaxWidth="840" Foreground="#45525F" LineHeight="23" />
                        <TextBlock Text="未找到来源缓存时会保留上次有效快照；官方模式使用 Codex 自己维护的模型目录。" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="环境与更新">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="环境" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EnvironmentSummary}" TextWrapping="Wrap" Margin="0,10,0,14" />
                        <WrapPanel>
                            <Button Content="检查环境" Command="{Binding CheckEnvironmentCommand}" />
                            <Button Content="准备聊天兼容" Command="{Binding PrepareHistoryCommand}" />
                            <Button Content="完整扫描" Command="{Binding FullHistoryCommand}" Margin="0" />
                            <Button Content="检查项目归属" Command="{Binding ProjectScanCommand}" />
                            <Button Content="修复项目归属" Command="{Binding ProjectRepairCommand}" />
                             <Button Content="取消操作" Command="{Binding CancelOperationCommand}" IsEnabled="True" Margin="0" />
                        </WrapPanel>
                        <TextBlock Text="{Binding OperationStatus}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" Margin="0,10,0,0" />
                        <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" MinHeight="260" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="更新" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,10,0,12" />
                        <Button Content="检查更新" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left" />
                        <Button Content="下载并安装" Command="{Binding DownloadAndInstallUpdateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <Button Content="打开项目发行页" Command="{Binding OpenReleasePageCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding DataLocation}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FooterStatus}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" />
        </DockPanel>
    </Grid>
</Window>
