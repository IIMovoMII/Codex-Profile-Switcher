<UserControl x:Class="Switcher.Desktop.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Switcher.Desktop.Controls">
    <ScrollViewer Padding="0,0,3,16"><StackPanel>
        <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="诊断与维护" Style="{StaticResource Heading}"/><TextBlock Text="查看运行环境，处理聊天、项目和桌面状态问题。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel><Button Content="重新检查" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Command="{Binding CheckEnvironmentCommand}" IsEnabled="{Binding IsIdle}"/></Grid>
        <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Border Background="{StaticResource SoftAccent}" CornerRadius="9" Padding="8"><ui:SymbolIcon Kind="monitor" Width="26" Height="26"/></Border><TextBlock Text="运行环境" Style="{StaticResource SectionHeading}" Margin="13,0,0,0"/></StackPanel>
            <ItemsControl ItemsSource="{Binding EnvironmentRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="145"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Kind="{Binding Icon}" Foreground="#54636D" Width="20"/><TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Foreground" Value="#B87612"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Style="{StaticResource Notice}" Margin="0,16,0,0"><TextBlock Text="{Binding EnvironmentMessage}" TextWrapping="Wrap"/></Border>
        </StackPanel></Border>
        <Border Style="{StaticResource Surface}"><StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Background="{StaticResource SoftAccent}" CornerRadius="9" Padding="8"><ui:SymbolIcon Kind="wrench" Width="26" Height="26"/></Border><TextBlock Text="维护工具" Style="{StaticResource SectionHeading}" Margin="13,0,0,0"/></StackPanel>
            <Grid Margin="0,10,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Kind="chat" Width="26" Height="26" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="聊天兼容" FontWeight="SemiBold"/><TextBlock Text="{Binding HistoryMessage}" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" IsEnabled="{Binding IsIdle}"><Button Content="增量准备" Command="{Binding PrepareHistoryCommand}" MinWidth="115"/><Button Content="完整检查并准备" Style="{StaticResource LinkButton}" FontSize="12" Command="{Binding FullHistoryCommand}" Margin="0,4,0,0"/></StackPanel></Grid>
            <Border Height="1" Background="{StaticResource Line}"/>
            <Grid Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Kind="layers" Width="26" Height="26" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="项目归属" FontWeight="SemiBold"/><TextBlock Text="{Binding ProjectMessage}" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" IsEnabled="{Binding IsIdle}"><Button Content="检查" Command="{Binding ProjectScanCommand}" MinWidth="115"/><Button Content="备份并修复" Command="{Binding ProjectRepairCommand}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding CanRepairProject, Converter={StaticResource BoolVisibility}}"/></StackPanel></Grid>
            <Border Height="1" Background="{StaticResource Line}"/>
            <Grid Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Kind="monitor" Width="26" Height="26" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="桌面状态" FontWeight="SemiBold"/><TextBlock Text="{Binding DesktopMessage}" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" IsEnabled="{Binding IsIdle}"><Button Content="检查" Command="{Binding DesktopScanCommand}" MinWidth="115"/><Button Content="备份并修复" Command="{Binding DesktopRepairCommand}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding CanRepairDesktop, Converter={StaticResource BoolVisibility}}"/></StackPanel></Grid>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><TextBlock Text="检查后显示实际结果；写入型准备或修复会先说明影响，并保留对应备份。一次性历史纠错不在普通切换中执行。" Style="{StaticResource Hint}" FontSize="12"/></Border>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
