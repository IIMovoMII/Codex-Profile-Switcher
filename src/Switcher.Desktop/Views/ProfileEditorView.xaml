<UserControl x:Class="Switcher.Desktop.Views.ProfileEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Switcher.Desktop.Controls" DataContextChanged="EditorChanged" KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="#F8FAFE" CornerRadius="19,0,0,19" BorderBrush="White" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="25,25,23,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" Background="{StaticResource SoftAccent}" CornerRadius="12"><ui:SymbolIcon Kind="{Binding IconKind}" Width="30" Height="30"/></Border>
                <StackPanel Grid.Column="1" Margin="16,0,10,0"><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource IconButton}" Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="关闭账号配置"><ui:SymbolIcon Kind="close" Foreground="{StaticResource Ink}" Width="17"/></Button>
            </Grid>
            <TabControl Grid.Row="1" Margin="24,0,24,0" SelectedIndex="{Binding SelectedTab}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}">
                <TabItem Header="账号信息"><ScrollViewer Padding="1,4,1,22"><StackPanel>
                    <TextBlock Text="账号名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="账号名称"/><TextBlock Text="用于在账号列表中区分不同连接。" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,24"/>
                    <StackPanel Visibility="{Binding IsApi, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="API 地址" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API 地址"/><TextBlock Text="填写服务商提供的完整接口地址，例如 https://api.example.com/v1。" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,24"/>
                        <TextBlock Text="{Binding KeyLabel}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="KeyInput" PasswordChanged="KeyChanged" AutomationProperties.Name="API Key"/><TextBlock Text="密钥使用 Windows DPAPI 加密，保存在当前用户的数据目录中。" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,24"/>
                    </StackPanel>
                    <Border Style="{StaticResource Notice}" Visibility="{Binding IsOfficial, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,20"><TextBlock Text="{Binding OfficialIdentity}" Style="{StaticResource Hint}"/></Border>
                    <Border Style="{StaticResource Notice}"><DockPanel><ui:SymbolIcon Kind="info" Margin="0,0,10,0" VerticalAlignment="Top"/><TextBlock Text="模型、代理和上下文可在对应标签页中单独配置。已有账号的配置在下次切换或重新应用时生效。" TextWrapping="Wrap"/></DockPanel></Border>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="模型设置"><ScrollViewer Padding="1,0,1,20"><StackPanel>
                    <Border Style="{StaticResource Surface}" Padding="19" Margin="0,0,0,14"><StackPanel>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Kind="cube" Margin="0,0,10,0"/><TextBlock Text="默认模型" Style="{StaticResource SectionHeading}"/></StackPanel><TextBlock Text="切换到这个账号时使用的默认模型。" Style="{StaticResource Hint}" FontSize="12" Margin="31,5,0,8"/>
                        <RadioButton Content="保留 Codex 当前设置" GroupName="ModelPolicy" IsChecked="{Binding ModelPolicy, Converter={StaticResource ChoiceEquals}, ConverterParameter=preserve}"/>
                        <RadioButton Content="沿用默认策略" ToolTip="默认模型沿用 Codex 当前值。" GroupName="ModelPolicy" IsChecked="{Binding ModelPolicy, Converter={StaticResource ChoiceEquals}, ConverterParameter=inherit}"/>
                        <RadioButton Content="为此账号指定模型" GroupName="ModelPolicy" IsChecked="{Binding ModelPolicy, Converter={StaticResource ChoiceEquals}, ConverterParameter=explicit}"/>
                        <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Models}" DisplayMemberPath="Id" Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSpecifyModel}" Margin="25,6,0,8" AutomationProperties.Name="默认模型 ID"/>
                        <TextBlock Text="已有聊天中的模型选择保持原样。可选择本地目录中的模型，或输入完整模型 ID。" Style="{StaticResource Hint}" FontSize="12"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Surface}" Padding="19" Visibility="{Binding IsApi, Converter={StaticResource BoolVisibility}}"><StackPanel>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Kind="layers" Margin="0,0,10,0"/><TextBlock Text="模型列表来源" Style="{StaticResource SectionHeading}"/></StackPanel>
                        <RadioButton Content="跟随指定官方账号的本地目录" GroupName="CatalogSource" Margin="0,14,0,6" IsChecked="{Binding CatalogMode, Converter={StaticResource ChoiceEquals}, ConverterParameter=official}"/>
                        <ComboBox ItemsSource="{Binding Officials}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SourceOfficialId}" Margin="25,4,0,6" Visibility="{Binding CatalogMode, Converter={StaticResource PageVisibility}, ConverterParameter=official}" AutomationProperties.Name="官方目录来源"/>
                        <TextBlock Text="尚无官方账号；可以选择下方手动维护方式。" Style="{StaticResource Hint}" FontSize="12" Visibility="{Binding HasNoOfficials, Converter={StaticResource BoolVisibility}}" Margin="25,0,0,6"/>
                        <RadioButton Content="手动维护目录" GroupName="CatalogSource" IsChecked="{Binding CatalogMode, Converter={StaticResource ChoiceEquals}, ConverterParameter=manual}"/>
                        <Grid Margin="0,8,0,10" Visibility="{Binding CatalogMode, Converter={StaticResource PageVisibility}, ConverterParameter=manual}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ManualPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="手动目录路径" ToolTip="留空时使用默认 relay-models.json"/><Button Content="选择文件" Grid.Column="1" Margin="9,0,0,0" Command="{Binding ChooseCatalogCommand}"/></Grid>
                        <TextBlock Text="实际目录文件" Style="{StaticResource FieldLabel}" Margin="0,6,0,5"/><TextBox Text="{Binding ResolvedCatalogPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" AutomationProperties.Name="实际模型目录路径"/>
                        <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,3"/><TextBlock Text="{Binding CatalogSource, StringFormat=同步来源：{0}}" Style="{StaticResource Hint}" FontSize="12"/><TextBlock Text="{Binding CatalogUpdated, StringFormat=更新时间：{0}}" Style="{StaticResource Hint}" FontSize="12"/>
                        <WrapPanel Margin="0,12,0,12"><Button Content="打开目录文件" Command="{Binding DataContext.OpenEditorCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="file" Padding="12,7" Margin="0,0,8,6"/><Button Content="打开所在文件夹" Command="{Binding DataContext.OpenEditorCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="folder" Padding="12,7" Margin="0,0,8,6"/><Button Content="刷新" Style="{StaticResource LinkButton}" Command="{Binding RefreshCatalogCommand}"/></WrapPanel>
                        <Border Style="{StaticResource Notice}" Padding="12"><StackPanel><TextBlock Text="模型列表来自本地完整目录，不会通过普通 /v1/models 接口更新。目录中出现某个模型，不代表接口支持调用。" FontSize="12" TextWrapping="Wrap" LineHeight="20"/><Expander Header="展开维护说明" Foreground="{StaticResource Accent}" Margin="0,8,0,0"><TextBlock Text="为兼容官方账号与 API 账号共享聊天，本助手的 API 模式可使用独立的本地模型目录。该目录不会自动从中转站的普通 /v1/models 接口更新。你可以从官方账号缓存同步，或手动维护上方文件；没有官方账号也可以继续使用和编辑已保存的目录。请按完整 Codex 模型目录格式修改，不能只填写模型名称。修改后完全退出并重新启动 Codex 生效。目录中出现某个模型，不代表中转站已经支持调用该模型。" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0"/></Expander></StackPanel></Border>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Notice}" Visibility="{Binding IsOfficial, Converter={StaticResource BoolVisibility}}"><TextBlock Text="官方账号继续由 Codex 原生更新模型列表。切换到官方账号时会移除切换器添加的目录覆盖；不会改写官方 models_cache.json。" TextWrapping="Wrap" LineHeight="23"/></Border>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="网络与上下文"><ScrollViewer Padding="1,4,1,22"><StackPanel>
                    <Border Style="{StaticResource Surface}" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="代理策略" Style="{StaticResource SectionHeading}"/><TextBlock Text="切换时调整 Codex 的系统代理设置，或保留当前值。" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,14"/><ComboBox ItemsSource="{Binding ProxyChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ProxyPolicy}" AutomationProperties.Name="账号代理策略"/></StackPanel></Border>
                    <Border Style="{StaticResource Surface}" Padding="20"><StackPanel><TextBlock Text="上下文窗口" Style="{StaticResource SectionHeading}"/><TextBlock Text="保留当前值，或在切换时使用此账号的独立策略。" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,14"/><ComboBox ItemsSource="{Binding ContextChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ContextPolicy}" AutomationProperties.Name="上下文策略"/><TextBox Text="{Binding ContextWindow, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSpecifyContext}" Margin="0,12,0,0" AutomationProperties.Name="上下文窗口数值"/></StackPanel></Border>
                    <TextBlock Text="这些设置只处理本次操作拥有的配置字段，保留其他个人偏好、聊天和项目内容。" Style="{StaticResource Hint}" Margin="0,18,0,0"/>
                </StackPanel></ScrollViewer></TabItem>
            </TabControl>
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,15,24,18" Background="#FAFCFF"><StackPanel>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#AC432F" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SaveHint}" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,16,0"/>
                    <Button Grid.Column="1" Content="取消" Margin="0,0,10,0" Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Grid.Column="2" Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.SaveEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </StackPanel></Border>
        </Grid>
    </Border>
</UserControl>
