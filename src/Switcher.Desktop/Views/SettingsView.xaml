<UserControl x:Class="Switcher.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Switcher.Desktop.Controls">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="设置与更新" Style="{StaticResource Heading}" Margin="0,0,0,25"/>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SettingsTab}">
            <TabItem Header="更新"><ScrollViewer Padding="1,4,3,18"><StackPanel>
                <Border Style="{StaticResource Surface}" Padding="30"><StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource SoftAccent}" Width="72" Height="72" CornerRadius="16" VerticalAlignment="Top" HorizontalAlignment="Left"><ui:SymbolIcon Kind="refresh" Width="45" Height="45"/></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding UpdateTitle}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Version, StringFormat=当前版本 {0}}" FontSize="18" Margin="0,8,0,0"/><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" Margin="0,9,0,20"/>
                            <WrapPanel IsEnabled="{Binding IsIdle}"><Button Content="下载更新" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadUpdateCommand}" Visibility="{Binding CanDownload, Converter={StaticResource BoolVisibility}}" Margin="0,0,12,8"/><Button Content="安装更新" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}" Visibility="{Binding CanInstall, Converter={StaticResource BoolVisibility}}" Margin="0,0,12,8"/><Button Content="重新检查" Command="{Binding CheckUpdatesCommand}" Margin="0,0,16,8" IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBoolean}}"/><Button Content="查看发布说明 ↗" Command="{Binding OpenReleasePageCommand}" Style="{StaticResource LinkButton}" Margin="0,0,0,8"/></WrapPanel>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,27,0,24"/>
                    <TextBlock Text="{Binding ReleaseNotesTitle}" Style="{StaticResource SectionHeading}"/>
                    <TextBlock Text="{Binding ReleaseNotesText}" TextWrapping="Wrap" LineHeight="25" Margin="0,13,0,20" Foreground="{StaticResource Muted}"/>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,24"/>
                    <TextBlock Text="更新流程" Style="{StaticResource SectionHeading}"/><TextBlock Text="从项目 GitHub Releases 获取版本与安装包。检查失败时可随时重试；下载完成后自动校验 SHA-256，再由你确认启动安装。" Style="{StaticResource Hint}" Margin="0,11,0,20"/>
                    <Border Style="{StaticResource Notice}"><DockPanel><ui:SymbolIcon Kind="info" Margin="0,0,10,0"/><TextBlock Text="更新应用会保留账号、模型目录、聊天与项目。" TextWrapping="Wrap"/></DockPanel></Border>
                </StackPanel></Border>
                <Grid Margin="8,24,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><CheckBox Style="{StaticResource SwitchToggle}" Content="每次启动时自动检查更新" IsChecked="{Binding AutoCheckUpdates}" Command="{Binding SaveAutoCheckCommand}" IsEnabled="{Binding IsIdle}"/><TextBlock Grid.Row="1" Text="{Binding LastUpdateCheck, StringFormat=最近检查：{0}}" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"/><Button Content="打开 GitHub 发布页 ↗" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource LinkButton}" Command="{Binding OpenReleasePageCommand}"/></Grid>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="默认策略"><ScrollViewer Padding="1,4,3,18"><Border Style="{StaticResource Surface}"><StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Text="切换时的默认策略" Style="{StaticResource SectionHeading}"/><TextBlock Text="账号可以覆盖默认策略，也可以选择保留 Codex 当前值。默认模型始终沿用当前值。" Style="{StaticResource Hint}" Margin="0,10,0,23"/>
                <TextBlock Text="官方账号代理" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DefaultProxyChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding DefaultOfficialProxy}" AutomationProperties.Name="默认官方代理" Margin="0,0,0,20" Width="460" HorizontalAlignment="Left"/>
                <TextBlock Text="API 账号代理" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DefaultProxyChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding DefaultApiProxy}" AutomationProperties.Name="默认 API 代理" Margin="0,0,0,20" Width="460" HorizontalAlignment="Left"/>
                <TextBlock Text="默认上下文窗口" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DefaultContextWindow, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="默认上下文窗口" Width="460" HorizontalAlignment="Left"/><TextBlock Text="留空表示保留当前值；填写正整数后，仅对选择“沿用默认策略”的账号生效。" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,22"/>
                <StackPanel Orientation="Horizontal"><Button Content="保存默认策略" Style="{StaticResource PrimaryButton}" Command="{Binding SavePreferencesCommand}"/><Button Content="重新读取" Command="{Binding LoadPreferencesCommand}" Margin="12,0,0,0"/></StackPanel><TextBlock Text="{Binding PreferencesMessage}" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
            </StackPanel></Border></ScrollViewer></TabItem>
            <TabItem Header="数据位置"><ScrollViewer Padding="1,4,3,18"><StackPanel><Border Style="{StaticResource Surface}"><StackPanel>
                <TextBlock Text="自动定位本地数据" Style="{StaticResource SectionHeading}"/><TextBlock Text="默认使用 Windows 当前用户的数据文件夹，聊天沿用 CODEX_HOME；也会自动查找已记住的位置与档案绑定的目录。只有这些位置失效，才需要手动选择。" Style="{StaticResource Hint}" Margin="0,10,0,16"/>
                <Border Style="{StaticResource Notice}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{Binding LocationMessage}" TextWrapping="Wrap"/><WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsIdle}"><Button Content="重新检查位置" Command="{Binding RecheckDataLocationsCommand}"/><Button Content="手动选择有效文件夹" Command="{Binding SelectFallbackFolderCommand}" Visibility="{Binding HasUnavailableLocations, Converter={StaticResource BoolVisibility}}" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
                <TextBlock Text="账号、凭据与操作记录" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{Binding DataDirectoryOrigin, StringFormat=定位来源：{0}}" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,0"/><Button Content="打开数据目录" HorizontalAlignment="Left" Command="{Binding OpenDataLocationCommand}" CommandParameter="data" Margin="0,10,0,22"/>
                <TextBlock Text="Codex 聊天与项目（CODEX_HOME）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CodexHome, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{Binding CodexHomeOrigin, StringFormat=定位来源：{0}}" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,0"/><Button Content="打开 Codex 目录" HorizontalAlignment="Left" Command="{Binding OpenDataLocationCommand}" CommandParameter="home" Margin="0,10,0,22"/>
                <TextBlock Text="默认手动模型目录" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ManualCatalogFile, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="各 API 账号可以使用不同路径；请在该账号的模型设置中查看实际文件。" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,22"/>
                <TextBlock Text="独立官方目录快照" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SnapshotsDirectory, Mode=OneWay}" IsReadOnly="True"/><Button Content="打开目录快照文件夹" HorizontalAlignment="Left" Command="{Binding OpenDataLocationCommand}" CommandParameter="catalogs" Margin="0,10,0,22"/>
                <TextBlock Text="历史兼容备份" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BackupsDirectory, Mode=OneWay}" IsReadOnly="True"/><Button Content="打开历史备份文件夹" HorizontalAlignment="Left" Command="{Binding OpenDataLocationCommand}" CommandParameter="backups" Margin="0,10,0,0"/>
            </StackPanel></Border><Border Style="{StaticResource Surface}" Margin="0,20,0,0"><StackPanel><TextBlock Text="备份与更新缓存" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding StoragePolicy}" Style="{StaticResource Hint}" Margin="0,10,0,16"/><Button Content="检查并清理过期文件" Command="{Binding MaintainStorageCommand}" HorizontalAlignment="Left" IsEnabled="{Binding IsIdle}"/><TextBlock Text="{Binding StorageMessage}" Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="关于"><ScrollViewer Padding="1,4,3,18"><Border Style="{StaticResource Surface}" Padding="32"><StackPanel><Border Background="{StaticResource PrimaryFill}" CornerRadius="14" Width="68" Height="68" HorizontalAlignment="Left"><ui:SymbolIcon Kind="code" Width="40" Height="40" Foreground="White"/></Border><TextBlock Text="Codex 切换助手" FontSize="26" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock Text="{Binding Version}" FontSize="18"/><TextBlock Text="在官方账号与第三方 API 档案之间切换，独立管理模型目录，保留本地聊天与项目。" Style="{StaticResource Hint}" Margin="0,18,0,10"/><TextBlock Text="C# · .NET 10 LTS · WPF · Windows x64" Style="{StaticResource Hint}"/><TextBlock Text="MIT 开源许可证" Style="{StaticResource Hint}" Margin="0,8,0,18"/><Button Content="项目与发布说明 ↗" HorizontalAlignment="Left" Command="{Binding OpenReleasePageCommand}"/></StackPanel></Border></ScrollViewer></TabItem>
        </TabControl>
    </Grid>
</UserControl>
