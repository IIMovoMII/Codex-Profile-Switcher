<Window x:Class="Switcher.Desktop.Views.LocationRecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="恢复数据位置 · Codex 切换助手" Width="720" Height="570" MinHeight="540" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowFill}">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="HeadingText" Text="自动定位暂时不可用" Style="{StaticResource SectionHeading}"/><TextBlock Text="请先检查磁盘连接或文件夹权限，也可以选择原有的有效文件夹。应用不会移动账号或聊天，不会为已有凭据更换解密路径。" Style="{StaticResource Hint}" Margin="0,10,0,20"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,0,0,20"/>
            <TextBlock Text="账号、凭据与备份文件夹" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DataPath" IsReadOnly="True" TextWrapping="Wrap"/><Button Grid.Column="1" Content="选择文件夹" Click="ChooseData" Margin="10,0,0,0"/></Grid>
            <TextBlock Text="Codex 聊天与项目文件夹（CODEX_HOME）" Style="{StaticResource FieldLabel}" Margin="0,22,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HomePath" IsReadOnly="True" TextWrapping="Wrap"/><Button Grid.Column="1" Content="选择文件夹" Click="ChooseHome" Margin="10,0,0,0"/></Grid>
            <TextBlock Text="选择已有账号目录后，会自动查找其原 CODEX_HOME。位置验证成功后会记住，下次启动自动使用。" Style="{StaticResource Hint}" FontSize="12" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="重试自动查找" Click="Retry" Margin="0,0,10,0"/><Button Content="取消" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="UseButton" Content="使用此位置" Style="{StaticResource PrimaryButton}" Click="UseLocations"/></StackPanel>
    </Grid>
</Window>
