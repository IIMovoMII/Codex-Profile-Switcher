<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex 账号切换" Width="1180" Height="810" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#FFFFFF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="#202124" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#7B8088"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#292D32"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#23272C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#23272C"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="16,13"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#E0E3E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,9"/><Setter Property="MinHeight" Value="40"/><Setter Property="BorderBrush" Value="#E0E3E7"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Background="White">
  <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F5F6F8" BorderBrush="#E9EBEE" BorderThickness="0,0,1,0">
   <Grid Margin="16,27,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="12,0,0,37"><Border Background="#24282D" Width="37" Height="37" CornerRadius="11"><TextBlock Text="›_" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Codex" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="账号切换器" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1">
     <TextBlock Text="工作区" Foreground="#969BA4" FontSize="11" Margin="16,0,0,9"/>
     <Button x:Name="NavAccounts" Style="{StaticResource Nav}" Background="#E6E9ED"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" FontSize="17" Width="29"/><TextBlock Text="账号与接口"/></StackPanel></Button>
     <Button x:Name="NavEnvironment" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="17" Width="29"/><TextBlock Text="环境检查"/></StackPanel></Button>
     <Button x:Name="NavLogs" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" FontSize="18" Width="29"/><TextBlock Text="操作记录"/></StackPanel></Button>
    </StackPanel>
    <Border Grid.Row="3" Background="#ECEEF1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="同一份聊天，同一份项目" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="SharedSummary" Text="账号之间共用本地数据" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,10"/><TextBlock x:Name="HomePath" Text="" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="10" Foreground="#90959E"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="40,25,40,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,26"><TextBlock x:Name="Breadcrumb" Text="工作区  /  账号与接口" Foreground="#959AA2" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="TopStatus" Text="本地运行" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="UpdateButton" Content="有新版本" Visibility="Collapsed" Padding="11,5" FontSize="11" Margin="0,0,9,0" ToolTip="下载并安装 GitHub 上的最新版本"/><Button x:Name="RefreshButton" Content="↻" FontSize="20" Padding="9,1" BorderThickness="0" ToolTip="刷新当前状态"/></StackPanel></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="AccountsPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,25"><StackPanel><TextBlock Text="账号与接口" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="切换你的连接方式，继续手头的工作。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Button x:Name="AddButton" Content="＋  添加账号" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Border Grid.Row="1" Background="#F3F7F5" BorderBrush="#E0EAE4" BorderThickness="1" CornerRadius="15" Padding="23,20" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="#479C74" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="当前连接" FontSize="11" Foreground="#638072"/></StackPanel><TextBlock x:Name="ActiveName" Text="从第一个账号开始" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock x:Name="ActiveDetail" Text="导入现有账号，或添加一个新的连接。" Foreground="#74837A" FontSize="12"/></StackPanel><Button Grid.Column="1" x:Name="ImportButton" Content="导入当前账号" VerticalAlignment="Center" Padding="16,10" Background="#F3F7F5" BorderBrush="#CCDCD1"/></Grid></Border>
     <Grid Grid.Row="2" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><Button x:Name="FilterAll" Content="全部" Padding="13,7" Background="#ECEEF1" BorderThickness="0" Margin="0,0,6,0"/><Button x:Name="FilterOfficial" Content="官方账号" Padding="13,7" BorderThickness="0" Margin="0,0,6,0"/><Button x:Name="FilterApi" Content="API 接口" Padding="13,7" BorderThickness="0"/></StackPanel><TextBox x:Name="SearchBox" Width="200" HorizontalAlignment="Right" Padding="11,7" ToolTip="搜索账号名称或接口地址"/></Grid>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"><StackPanel>
      <Border x:Name="EmptyPanel" Visibility="Collapsed" BorderBrush="#ECEEF1" BorderThickness="1" CornerRadius="14" Padding="30,38"><StackPanel HorizontalAlignment="Center"><TextBlock Text="所有连接，从这里管理" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="添加官方 ChatGPT 账号或自定义 API。&#x0a;后续新建的本地项目也会继续保留。" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,18"/><Button x:Name="EmptyAddButton" Content="添加第一个账号" Style="{StaticResource Primary}" HorizontalAlignment="Center"/></StackPanel></Border>
      <ItemsControl x:Name="ProfileList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E5E8EC" BorderThickness="1" CornerRadius="13" Padding="20,18" Margin="0,0,0,12" Background="White"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="34" Height="34" Background="#F0F2F5" CornerRadius="10" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="1,0,18,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="345"/><Border Background="#EAF5EE" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" Visibility="{Binding ActiveVisibility}"><TextBlock Text="使用中" Foreground="#4A8964" FontSize="10"/></Border></StackPanel><TextBlock Text="{Binding Subtitle}" Foreground="#7D838D" FontSize="12" Margin="0,7,0,9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="#9298A0" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding SwitchLabel}" Tag="switch" Padding="16,8" Margin="0,0,8,0"/><Button Content="···" Tag="menu" Padding="8,4" BorderThickness="0" FontSize="20" ToolTip="管理账号"/></StackPanel>
      </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock x:Name="ListHint" Text="切换前请完全退出 Codex Desktop 和 CLI。" FontSize="11" Foreground="#A0A5AD" Margin="2,7,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="EnvironmentPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,25"><TextBlock Text="环境检查" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="查看切换是否就绪，以及需要处理的问题。" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border x:Name="DiagnosticSummary" Background="#F3F7F5" CornerRadius="14" Padding="23,21" Margin="0,0,0,20">
        <StackPanel><TextBlock x:Name="DiagnosticTitle" Text="正在检查" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
       </Border>
       <StackPanel x:Name="DiagnosticList"/>
       <Expander x:Name="DiagnosticDetails" Header="检查明细" IsExpanded="False" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0" Padding="0,7">
        <StackPanel x:Name="PassedDiagnosticList" Margin="23,17,0,0"/>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,22"><TextBlock Text="操作记录" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="窗口会保留运行结果，方便查看每次切换做了什么。" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel><TextBlock Grid.Row="1" x:Name="LogHeading" Text="暂无操作" Foreground="#626A76" FontSize="12" Margin="0,0,0,12"/><Border Grid.Row="2" Background="#F7F8FA" BorderBrush="#E5E8EC" BorderThickness="1" CornerRadius="12" Padding="14"><TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" Text="操作结果会显示在这里。"/></Border></Grid>
   </Grid>
   <Border Grid.Row="2" x:Name="StatusBar" Background="#F5F6F8" CornerRadius="9" Padding="13,10" Margin="0,19,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#737B86" FontSize="11" VerticalAlignment="Center"/><Button x:Name="CancelButton" Grid.Column="1" Content="取消操作" Visibility="Collapsed" Padding="10,4" FontSize="11"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
